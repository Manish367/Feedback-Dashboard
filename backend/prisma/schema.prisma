generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  feedbacks Feedback[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  title        String?

  managerId    String?
  manager      User?    @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerReports")

  isHR         Boolean  @default(false)

  createdAt    DateTime @default(now())

  feedbackGiven    Feedback[] @relation("FeedbackGiver")
  feedbackReceived Feedback[] @relation("FeedbackReceiver")

  @@index([companyId])
  @@index([managerId])
}

model FeedbackParameter {
  id     String @id @default(cuid())
  key    String @unique
  label  String
  order  Int

  scores FeedbackScore[]
}

model Feedback {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  employeeId  String
  employee    User     @relation("FeedbackReceiver", fields: [employeeId], references: [id])

  managerId   String
  manager     User     @relation("FeedbackGiver", fields: [managerId], references: [id])

  period      String

  submittedAt DateTime @default(now())

  scores      FeedbackScore[]

  @@unique([employeeId, period])
  @@index([companyId, period])
  @@index([managerId])
}

model FeedbackScore {
  id          String   @id @default(cuid())
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  parameterId String
  parameter   FeedbackParameter @relation(fields: [parameterId], references: [id])

  score       Int
  comment     String

  @@unique([feedbackId, parameterId])
}
