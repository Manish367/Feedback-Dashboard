// Performance feedback tool — data model
//
// Design notes (see README for full write-up):
// - Multi-tenant: every User and Feedback row is scoped to a Company. One login
//   page, many companies — the backend resolves company from the authenticated user.
// - Org hierarchy is a single self-referential edge on User (managerId), not a
//   fixed "role" enum. This is what lets Priya be simultaneously a report (of Rohan)
//   and a manager (of her 6 reports), and lets a chain go arbitrarily deep
//   (COO -> Rohan -> Priya -> reports) or be flat (founder -> 8 reports).
// - "Manager" and "employee" are not stored roles — they're derived by asking
//   whether a user has any reports. isHR is the one real role flag, and it's
//   scoped per-company so an HR lead only ever sees their own company's data.
// - Feedback is monthly, per (employee, period), covering all 5 fixed parameters
//   in one submission. The unique constraint on (employeeId, period) is what makes
//   "who hasn't submitted this month" a simple query instead of an inferred state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  feedbacks Feedback[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  title        String?

  // Self-referential org chart edge. Null = top of the tree for their company
  // (e.g. a founder or a COO whose own manager isn't modeled in the system).
  managerId    String?
  manager      User?    @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerReports")

  // Company-scoped permission flag (not a global admin) — an HR lead at one
  // pilot company has zero visibility into another pilot company's data.
  isHR         Boolean  @default(false)

  createdAt    DateTime @default(now())

  feedbackGiven    Feedback[] @relation("FeedbackGiver")
  feedbackReceived Feedback[] @relation("FeedbackReceiver")

  @@index([companyId])
  @@index([managerId])
}

// Fixed set of 5 parameters, shared across every company on the platform.
// Modeled as rows (not an enum) so an order/label can be tweaked without a
// migration, but the *set* is intentionally not per-company in this version.
model FeedbackParameter {
  id     String @id @default(cuid())
  key    String @unique
  label  String
  order  Int

  scores FeedbackScore[]
}

// One submission = one manager giving one employee feedback for one month,
// covering all 5 parameters. The (employeeId, period) unique constraint is
// the crux of the model: it guarantees at most one submission per employee
// per month, which is what makes both the employee trend view and the HR
// "missing submissions" view simple, reliable queries rather than derived
// heuristics over loose rows.
model Feedback {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  employeeId  String
  employee    User     @relation("FeedbackReceiver", fields: [employeeId], references: [id])

  managerId   String
  manager     User     @relation("FeedbackGiver", fields: [managerId], references: [id])

  // "YYYY-MM" — a calendar month, not a free-form date, since feedback is
  // explicitly monthly and cycles need to be comparable/sortable as strings.
  period      String

  submittedAt DateTime @default(now())

  scores      FeedbackScore[]

  @@unique([employeeId, period])
  @@index([companyId, period])
  @@index([managerId])
}

model FeedbackScore {
  id          String   @id @default(cuid())
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  parameterId String
  parameter   FeedbackParameter @relation(fields: [parameterId], references: [id])

  score       Int      // 1-5
  comment     String

  @@unique([feedbackId, parameterId])
}
